{
  "scopeName": "maven-test-explorer.output.injection",
  "injectionSelector": "L:text.log",
  "patterns": [
    {
      "match": "(\\[Test Progress · Summary\\])\\s+(✓)\\s+(PASSED)\\s+(│)\\s+(Σ)\\s+(\\d+)(\\s+total)\\s+(│)\\s+(✓)\\s+(\\d+)(\\s+passed)\\s+(│)\\s+(✗)\\s+(\\d+)(\\s+failed)\\s+(│)\\s+(⊗)\\s+(\\d+)(\\s+errors)\\s+(│)\\s+(⊘)\\s+(\\d+)(\\s+skipped)\\s+(│)\\s+(◷)\\s+([0-9.]+(?:ms|s))$",
      "captures": {
        "1": { "name": "markup.heading.maven-test-explorer" },
        "2": { "name": "markup.inserted log.info" },
        "4": { "name": "comment.maven-test-explorer" },
        "5": { "name": "constant.numeric.maven-test-explorer" },
        "6": { "name": "constant.numeric.maven-test-explorer" },
        "8": { "name": "comment.maven-test-explorer" },
        "9": { "name": "markup.inserted log.info" },
        "10": { "name": "constant.numeric.maven-test-explorer" },
        "12": { "name": "comment.maven-test-explorer" },
        "13": { "name": "token.error-token" },
        "14": { "name": "constant.numeric.maven-test-explorer" },
        "16": { "name": "comment.maven-test-explorer" },
        "17": { "name": "token.error-token" },
        "18": { "name": "constant.numeric.maven-test-explorer" },
        "20": { "name": "comment.maven-test-explorer" },
        "22": { "name": "constant.numeric.maven-test-explorer" },
        "24": { "name": "comment.maven-test-explorer" },
        "25": { "name": "constant.numeric.maven-test-explorer" },
        "26": { "name": "constant.numeric.maven-test-explorer" }
      }
    },
    {
      "match": "(\\[Test Progress · Summary\\])\\s+(✗)\\s+(FAILED)\\s+(│)\\s+(Σ)\\s+(\\d+)(\\s+total)\\s+(│)\\s+(✓)\\s+(\\d+)(\\s+passed)\\s+(│)\\s+(✗)\\s+(\\d+)(\\s+failed)\\s+(│)\\s+(⊗)\\s+(\\d+)(\\s+errors)\\s+(│)\\s+(⊘)\\s+(\\d+)(\\s+skipped)\\s+(│)\\s+(◷)\\s+([0-9.]+(?:ms|s))$",
      "captures": {
        "1": { "name": "markup.heading.maven-test-explorer" },
        "2": { "name": "token.error-token" },
        "4": { "name": "comment.maven-test-explorer" },
        "5": { "name": "constant.numeric.maven-test-explorer" },
        "6": { "name": "constant.numeric.maven-test-explorer" },
        "8": { "name": "comment.maven-test-explorer" },
        "9": { "name": "markup.inserted log.info" },
        "10": { "name": "constant.numeric.maven-test-explorer" },
        "12": { "name": "comment.maven-test-explorer" },
        "13": { "name": "token.error-token" },
        "14": { "name": "constant.numeric.maven-test-explorer" },
        "16": { "name": "comment.maven-test-explorer" },
        "17": { "name": "token.error-token" },
        "18": { "name": "constant.numeric.maven-test-explorer" },
        "20": { "name": "comment.maven-test-explorer" },
        "22": { "name": "constant.numeric.maven-test-explorer" },
        "24": { "name": "comment.maven-test-explorer" },
        "25": { "name": "constant.numeric.maven-test-explorer" },
        "26": { "name": "constant.numeric.maven-test-explorer" }
      }
    },
    {
      "match": "(\\[Test Progress · Summary\\])\\s+(■)\\s+(CANCELLED)\\s+(│)\\s+(Σ)\\s+(\\d+)(\\s+total)\\s+(│)\\s+(✓)\\s+(\\d+)(\\s+passed)\\s+(│)\\s+(✗)\\s+(\\d+)(\\s+failed)\\s+(│)\\s+(⊗)\\s+(\\d+)(\\s+errors)\\s+(│)\\s+(⊘)\\s+(\\d+)(\\s+skipped)\\s+(│)\\s+(◷)\\s+([0-9.]+(?:ms|s))$",
      "captures": {
        "1": { "name": "markup.heading.maven-test-explorer" },
        "2": { "name": "token.warn-token" },
        "4": { "name": "comment.maven-test-explorer" },
        "5": { "name": "constant.numeric.maven-test-explorer" },
        "6": { "name": "constant.numeric.maven-test-explorer" },
