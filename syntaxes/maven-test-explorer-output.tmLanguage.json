        "16": { "name": "comment.maven-test-explorer" },
        "17": { "name": "token.error-token" },
        "18": { "name": "constant.numeric.maven-test-explorer" },
        "20": { "name": "comment.maven-test-explorer" },
        "22": { "name": "constant.numeric.maven-test-explorer" },
        "24": { "name": "comment.maven-test-explorer" },
        "25": { "name": "constant.numeric.maven-test-explorer" },
        "26": { "name": "constant.numeric.maven-test-explorer" }
      }
    },
    {
      "match": "(\\[Test Progress\\])\\s+(✓)\\s+(\\d+)(\\s+passed)\\s+(│)\\s+(✗)\\s+(\\d+)(\\s+failed)\\s+(│)\\s+(⊘)\\s+(\\d+)(\\s+skipped)(?:\\s+(│)\\s+(>>)\\s+(\\d+)(\\s+remaining))?$",
      "captures": {
        "1": { "name": "markup.heading.maven-test-explorer" },
        "2": { "name": "markup.inserted log.info" },
        "3": { "name": "constant.numeric.maven-test-explorer" },
        "5": { "name": "comment.maven-test-explorer" },
        "6": { "name": "token.error-token" },
        "7": { "name": "constant.numeric.maven-test-explorer" },
        "9": { "name": "comment.maven-test-explorer" },
        "11": { "name": "constant.numeric.maven-test-explorer" },
        "13": { "name": "comment.maven-test-explorer" },
        "14": { "name": "token.warn-token" },
        "15": { "name": "constant.numeric.maven-test-explorer" }
      }
    },
    {
      "match": "\\[ERROR\\].*$|\\bBUILD FAILURE\\b.*$",
      "name": "markup.deleted.maven-test-explorer"
    },
    {
      "match": "\\[Maven\\] (?:Process error:.*|Exited with code (?!0\\b).*)$|\\[Results\\] NO (?:MODULE|ITEM):.*$|\\[(?:Runner|Profiles|Agent Bridge)\\].*(?:Failed|Cannot|Unable).*$",
      "name": "markup.deleted.maven-test-explorer"
    },
    {
      "match": "\\bBUILD SUCCESS\\b.*$",
      "name": "markup.inserted.maven-test-explorer"
    },
    {
      "match": "\\[Maven\\] Run cancelled by user\\.$",
      "name": "markup.changed.maven-test-explorer"
    },
    {
      "match": "\\[(WARNING|WARN)\\].*$",
      "name": "markup.changed.maven-test-explorer"
    },
    {
      "match": "(\\[Results\\])\\s+(\\d+\\s+tests)\\s+—\\s+(\\d+\\s+passed),\\s+(\\d+\\s+failed),\\s+(\\d+\\s+errors),\\s+(\\d+\\s+skipped)$",
      "captures": {
        "1": { "name": "entity.name.section.maven-test-explorer" },
        "2": { "name": "constant.numeric.maven-test-explorer" },
        "3": { "name": "markup.inserted.maven-test-explorer" },
        "4": { "name": "markup.deleted.maven-test-explorer" },
        "5": { "name": "markup.deleted.maven-test-explorer" },
        "6": { "name": "markup.changed.maven-test-explorer" }
      }
    },
    {
      "match": "\\[(Runner|Maven|Results|Test Progress|Test Progress · Summary)\\]",
      "name": "entity.name.section.maven-test-explorer"
    },
    {
      "match": "\\[(Watcher|Cache|Discovery|Extension|Profiles|Agent Bridge)\\]",
      "name": "comment.maven-test-explorer"
    }
  ]
}
