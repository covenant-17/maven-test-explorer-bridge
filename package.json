{
  "name": "maven-test-explorer-bridge",
  "displayName": "Maven Test Explorer Bridge",
  "description": "Custom Maven/Surefire test explorer for the VS Code Testing sidebar.",
  "version": "1.0.0",
  "publisher": "covenant-17",
  "license": "MIT",
  "icon": "icon-17-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/covenant-17/maven-test-explorer-bridge"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Testing"
  ],
  "keywords": [
    "java",
    "maven",
    "junit",
    "surefire",
    "test explorer"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:mavenTestExplorer.view",
    "workspaceContains:**/pom.xml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mavenTestExplorer.refreshTests",
        "title": "Maven: Refresh Tests",
        "category": "Maven Test Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "mavenTestExplorer.runAllTests",
        "title": "Maven: Run All Tests",
        "category": "Maven Test Explorer",
        "icon": "$(run-all)"
      },
      {
        "command": "mavenTestExplorer.expandAll",
        "title": "Expand All",
        "category": "Maven Test Explorer",
        "icon": "$(expand-all)"
      },
      {
        "command": "mavenTestExplorer.collapseAll",
        "title": "Collapse All",
        "category": "Maven Test Explorer",
        "icon": "$(collapse-all)"
      },
      {
        "command": "mavenTestExplorer.sortByLocation",
        "title": "Sort by Location",
        "category": "Maven Test Explorer",
        "icon": "$(list-tree)"
      },
      {
        "command": "mavenTestExplorer.sortByStatus",
        "title": "Sort by Status",
        "category": "Maven Test Explorer",
        "icon": "$(checklist)"
      },
      {
        "command": "mavenTestExplorer.sortByDuration",
        "title": "Sort by Duration",
        "category": "Maven Test Explorer",
        "icon": "$(watch)"
      },
      {
        "command": "mavenTestExplorer.rerunFailed",
        "title": "Maven: Re-run Failed Tests",
        "category": "Maven Test Explorer"
      },
      {
        "command": "mavenTestExplorer.cleanReports",
        "title": "Maven: Clean Test Reports",
        "category": "Maven Test Explorer"
      },
      {
        "command": "mavenTestExplorer.copyMavenCommand",
        "title": "Maven: Copy Maven Command for Test",
        "category": "Maven Test Explorer"
      },
      {
        "command": "mavenTestExplorer.copy",
        "title": "Copy...",
        "category": "Maven Test Explorer"
      },
      {
        "command": "mavenTestExplorer.copyItemMavenCommand",
        "title": "Copy Maven Command",
        "category": "Maven Test Explorer"
      },
      {
        "command": "mavenTestExplorer.copyClassName",
        "title": "Copy Class Name (FQCN)",
        "category": "Maven Test Explorer"
      },
      {
        "command": "mavenTestExplorer.copyMethodName",
        "title": "Copy Method Name",
        "category": "Maven Test Explorer"
      },
      {
        "command": "mavenTestExplorer.copyPackageName",
        "title": "Copy Package Name",
        "category": "Maven Test Explorer"
      },
      {
        "command": "mavenTestExplorer.copyFullPath",
        "title": "Copy Full Path",
        "category": "Maven Test Explorer"
      },
      {
        "command": "mavenTestExplorer.clearResults",
        "title": "Maven: Clear Test Results",
        "category": "Maven Test Explorer",
        "icon": "$(clear-all)"
      },
      {
        "command": "mavenTestExplorer.clearResultsAndHistory",
        "title": "Maven: Clear Results & History",
        "category": "Maven Test Explorer",
        "icon": "$(trash)"
      },
      {
        "command": "mavenTestExplorer.showHistory",
        "title": "Maven: Show Run History",
        "category": "Maven Test Explorer",
        "icon": "$(history)"
      },
      {
        "command": "mavenTestExplorer.attachToCopilot",
        "title": "Attach to Copilot Chat",
        "category": "Maven Test Explorer",
        "icon": "$(copilot)"
      },
      {
        "command": "mavenTestExplorer.attachToClaude",
        "title": "Attach to Claude",
        "category": "Maven Test Explorer",
        "icon": "$(comment-discussion)"
      }
    ],
    "views": {
      "test": [
        {
          "type": "webview",
          "id": "mavenTestExplorer.view",
          "name": "Maven Test Explorer"
        }
      ]
    },
    "submenus": [],
    "menus": {
      "view/title": [
        {
          "command": "mavenTestExplorer.refreshTests",
          "group": "navigation@1",
          "when": "view == mavenTestExplorer.view"
        },
        {
          "command": "mavenTestExplorer.runAllTests",
          "group": "navigation@2",
          "when": "view == mavenTestExplorer.view"
        },
        {
          "command": "mavenTestExplorer.expandAll",
          "group": "navigation@3",
          "when": "view == mavenTestExplorer.view && !mavenTestExplorer.hasExpandedItems"
        },
        {
          "command": "mavenTestExplorer.collapseAll",
          "group": "navigation@3",
          "when": "view == mavenTestExplorer.view && mavenTestExplorer.hasExpandedItems"
        },
        {
          "command": "mavenTestExplorer.clearResults",
          "group": "navigation@5",
          "when": "view == mavenTestExplorer.view"
        },
        {
          "command": "mavenTestExplorer.clearResultsAndHistory",
          "group": "navigation@6",
          "when": "view == mavenTestExplorer.view"
        },
        {
          "command": "mavenTestExplorer.sortByLocation",
          "group": "navigation@7",
          "when": "view == mavenTestExplorer.view",
          "toggled": "mavenTestExplorer.sortMode == location"
        },
        {
          "command": "mavenTestExplorer.sortByStatus",
          "group": "navigation@8",
          "when": "view == mavenTestExplorer.view",
          "toggled": "mavenTestExplorer.sortMode == status"
        },
        {
          "command": "mavenTestExplorer.sortByDuration",
          "group": "navigation@9",
          "when": "view == mavenTestExplorer.view",
          "toggled": "mavenTestExplorer.sortMode == duration"
        },
        {
          "command": "mavenTestExplorer.showHistory",
          "group": "navigation@4",
          "when": "view == mavenTestExplorer.view"
        }
      ],
      "commandPalette": [
        {
          "command": "mavenTestExplorer.expandAll",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.collapseAll",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByLocation",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByStatus",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByDuration",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "title": "Test Discovery",
        "properties": {
          "mavenTestExplorer.mavenExecutable": {
            "type": "string",
            "default": "mvn",
            "description": "Path to the Maven executable (e.g. 'mvn' or '/usr/local/bin/mvn')."
          },
          "mavenTestExplorer.preferMavenWrapper": {
            "type": "boolean",
            "default": true,
            "description": "Use mvnw / mvnw.cmd (Maven Wrapper) if found in the module or its parent directory, instead of the global Maven executable."
          },
          "mavenTestExplorer.multiModuleMode": {
            "type": "string",
            "enum": ["auto", "root", "perModule"],
            "default": "auto",
            "description": "How to handle multi-module Maven projects. 'auto' detects automatically."
          },
          "mavenTestExplorer.testSourceGlobs": {
            "type": "array",
            "items": { "type": "string" },
            "default": ["**/src/test/java/**/*.java"],
            "description": "Glob patterns for Java test source files. Add extra patterns for non-standard source directories (e.g. '**/src/it/java/**/*.java')."
          },
          "mavenTestExplorer.autoRefreshOnSave": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "Automatically refresh the test tree when Java test files are created, deleted, or saved."
          },
          "mavenTestExplorer.autoRefreshDebounceMs": {
            "type": "number",
            "default": 500,
            "minimum": 100,
            "maximum": 5000,
            "order": 2,
            "description": "Delay in milliseconds before the test tree is refreshed after a file change. Increase on large projects or slow machines."
          }
        }
      },
      {
        "title": "Test Execution",
        "properties": {
          "mavenTestExplorer.defaultCommand": {
            "type": "string",
            "default": "clean test",
            "description": "Maven goals to run when executing tests (e.g. 'clean test')."
          },
          "mavenTestExplorer.defaultProfiles": {
            "type": "array",
            "items": { "type": "string" },
            "default": [],
            "description": "Maven profiles to activate by default (e.g. [\"dev\", \"ci\"])."
          },
          "mavenTestExplorer.additionalArgs": {
            "type": "string",
            "default": "",
            "description": "Additional arguments appended to every Maven command (e.g. '-Denv=dev01 -Dheadless=false')."
          },
          "mavenTestExplorer.clearReportsBeforeRun": {
            "type": "boolean",
            "default": true,
            "description": "Delete existing surefire-reports before running tests to prevent stale results."
          },
          "mavenTestExplorer.testClassCommandTemplate": {
            "type": "string",
            "default": "{maven} {profiles} {args} -Dtest={className} test",
            "description": "Template for running a single test class. Placeholders: {maven}, {profiles}, {args}, {className}."
          },
          "mavenTestExplorer.testMethodCommandTemplate": {
            "type": "string",
            "default": "{maven} {profiles} {args} -Dtest={className}#{methodName} test",
            "description": "Template for running a single test method. Placeholders: {maven}, {profiles}, {args}, {className}, {methodName}."
          }
        }
      },
      {
        "title": "Results & Display",
        "properties": {
          "mavenTestExplorer.showOutputChannel": {
            "type": "boolean",
            "default": true,
            "description": "Automatically reveal the Maven output panel when a test run starts."
          },
          "mavenTestExplorer.showStats": {
            "type": "boolean",
            "default": true,
            "description": "Show pass/fail aggregate counts next to each node in the test tree."
          },
          "mavenTestExplorer.statsFormat": {
            "type": "string",
            "default": "| ✓{passed} | ✗{failed} | ⭾ {skipped} | ● {total} ",
            "description": "Format string for aggregate stats shown on test tree nodes. Available placeholders: {passed} — passed count, {failed} — failed + error count, {error} — error count (raw), {skipped} — skipped count, {total} — total count."
          },
          "mavenTestExplorer.reportGlobs": {
            "type": "array",
            "items": { "type": "string" },
            "default": [
              "**/target/surefire-reports/TEST-*.xml",
              "**/target/failsafe-reports/TEST-*.xml"
            ],
            "description": "Glob patterns for Surefire/Failsafe XML report files."
          },
          "mavenTestExplorer.watchReports": {
            "type": "boolean",
            "default": true,
            "description": "Automatically update Test Explorer when report XML files change (external Maven runs)."
          }
        }
      },
      {
        "title": "Run History",
        "properties": {
          "mavenTestExplorer.runHistoryEnabled": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "Save test runs to history for later review via the History button."
          },
          "mavenTestExplorer.maxHistoryEntries": {
            "type": "number",
            "default": 20,
            "minimum": 1,
            "maximum": 100,
            "order": 2,
            "description": "Maximum number of test run history entries to keep."
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "npm run check-types && npm run validate:webview && node esbuild.js",
    "check-types": "tsc --noEmit",
    "validate:webview": "node scripts/validate-webview.js",
    "watch": "npm-run-all -p watch:esbuild watch:tsc",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run validate:webview && node esbuild.js --production",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.84.0",
    "esbuild": "^0.20.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "fast-xml-parser": "^4.3.0"
  }
}
