{
  "name": "maven-test-explorer-bridge",
  "displayName": "Maven Test Explorer Bridge",
  "description": "Custom Maven/Surefire test explorer for the VS Code Testing sidebar.",
  "version": "1.0.3",
  "publisher": "covenant-17",
  "license": "MIT",
  "icon": "icon-17-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/covenant-17/maven-test-explorer-bridge"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Testing"
  ],
  "keywords": [
    "java",
    "maven",
    "junit",
    "surefire",
    "test explorer"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:mavenTestExplorer.view",
    "workspaceContains:**/pom.xml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mavenTestExplorer.refreshTests",
        "title": "Maven: Refresh Tests",
        "category": "Maven Test Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "mavenTestExplorer.runAllTests",
        "title": "Maven: Run All Tests",
        "category": "Maven Test Explorer",
        "icon": "$(run-all)"
      },
      {
        "command": "mavenTestExplorer.expandAll",
        "title": "Expand All",
        "category": "Maven Test Explorer",
        "icon": "$(expand-all)"
      },
      {
        "command": "mavenTestExplorer.collapseAll",
        "title": "Collapse All",
        "category": "Maven Test Explorer",
        "icon": "$(collapse-all)"
      },
      {
        "command": "mavenTestExplorer.sortByLocation",
        "title": "Sort by Location",
        "category": "Maven Test Explorer",
        "icon": "$(list-tree)"
      },
      {
        "command": "mavenTestExplorer.sortByLocationAsc",
        "title": "Sort by Location    ● ASC",
        "category": "Maven Test Explorer",
        "icon": "$(list-tree)"
      },
      {
        "command": "mavenTestExplorer.sortByLocationDesc",
        "title": "Sort by Location    ● DESC",
        "category": "Maven Test Explorer",
        "icon": "$(list-tree)"
      },
      {
        "command": "mavenTestExplorer.sortByName",
        "title": "Sort by Name",
        "category": "Maven Test Explorer",
        "icon": "$(symbol-string)"
      },
      {
        "command": "mavenTestExplorer.sortByNameAsc",
        "title": "Sort by Name    ● ASC",
        "category": "Maven Test Explorer",
        "icon": "$(symbol-string)"
      },
      {
        "command": "mavenTestExplorer.sortByNameDesc",
        "title": "Sort by Name    ● DESC",
        "category": "Maven Test Explorer",
        "icon": "$(symbol-string)"
      },
      {
        "command": "mavenTestExplorer.sortByStatus",
        "title": "Sort by Status",
        "category": "Maven Test Explorer",
        "icon": "$(checklist)"
      },
      {
        "command": "mavenTestExplorer.sortByStatusAsc",
        "title": "Sort by Status    ● ASC",
        "category": "Maven Test Explorer",
        "icon": "$(checklist)"
      },
      {
        "command": "mavenTestExplorer.sortByStatusDesc",
        "title": "Sort by Status    ● DESC",
        "category": "Maven Test Explorer",
        "icon": "$(checklist)"
      },
      {
        "command": "mavenTestExplorer.sortByDuration",
        "title": "Sort by Duration",
        "category": "Maven Test Explorer",
        "icon": "$(watch)"
      },
      {
        "command": "mavenTestExplorer.sortByDurationAsc",
        "title": "Sort by Duration    ● ASC",
        "category": "Maven Test Explorer",
        "icon": "$(watch)"
      },
      {
        "command": "mavenTestExplorer.sortByDurationDesc",
        "title": "Sort by Duration    ● DESC",
        "category": "Maven Test Explorer",
        "icon": "$(watch)"
      },
      {
        "command": "mavenTestExplorer.showListView",
        "title": "Show List View",
        "category": "Maven Test Explorer",
        "icon": "$(list-flat)"
      },
      {
        "command": "mavenTestExplorer.showTreeView",
        "title": "Show Tree View",
        "category": "Maven Test Explorer",
        "icon": "$(list-tree)"
      },
      {
        "command": "mavenTestExplorer.rerunFailed",
        "title": "Maven: Re-run Failed Tests",
        "category": "Maven Test Explorer"
      },
      {
        "command": "mavenTestExplorer.cleanReports",
        "title": "Maven: Clean Test Reports",
        "category": "Maven Test Explorer"
      },
      {
        "command": "mavenTestExplorer.clearResults",
        "title": "Clear Test Results",
        "category": "Maven Test Explorer",
        "icon": "$(clear-all)"
      },
      {
        "command": "mavenTestExplorer.clearResultsAndHistory",
        "title": "Clear Results & History",
        "category": "Maven Test Explorer",
        "icon": "$(trash)"
      },
      {
        "command": "mavenTestExplorer.showHistory",
        "title": "Maven: Show Run History",
        "category": "Maven Test Explorer",
        "icon": "$(history)"
      },
      {
        "command": "mavenTestExplorer.revealInCustomExplorer",
        "title": "Reveal in Maven Test Explorer",
        "category": "Maven Test Explorer",
        "icon": "$(list-tree)"
      },
      {
        "command": "mavenTestExplorer.configureTreeVisibleParts",
        "title": "Configure Tree Visible Parts...",
        "category": "Maven Test Explorer"
      },
      {
        "command": "mavenTestExplorer.configureListVisibleParts",
        "title": "Configure List Visible Parts...",
        "category": "Maven Test Explorer"
      }
    ],
    "views": {
      "test": [
        {
          "type": "webview",
          "id": "mavenTestExplorer.view",
          "name": "Maven Test Explorer"
        }
      ]
    },
    "submenus": [
      {
        "id": "mavenTestExplorer.sortMenu",
        "label": "Sort Tests",
        "icon": "$(sort-precedence)"
      },
      {
        "id": "mavenTestExplorer.clearMenu",
        "label": "Clear Test Data",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mavenTestExplorer.refreshTests",
          "group": "navigation@2",
          "when": "view == mavenTestExplorer.view"
        },
        {
          "command": "mavenTestExplorer.runAllTests",
          "group": "navigation@1",
          "when": "view == mavenTestExplorer.view"
        },
        {
          "command": "mavenTestExplorer.expandAll",
          "group": "navigation@4",
          "when": "view == mavenTestExplorer.view && !mavenTestExplorer.hasExpandedItems"
        },
        {
          "command": "mavenTestExplorer.collapseAll",
          "group": "navigation@4",
          "when": "view == mavenTestExplorer.view && mavenTestExplorer.hasExpandedItems"
        },
        {
          "submenu": "mavenTestExplorer.clearMenu",
          "group": "navigation@5",
          "when": "view == mavenTestExplorer.view"
        },
        {
          "submenu": "mavenTestExplorer.sortMenu",
          "group": "navigation@7",
          "when": "view == mavenTestExplorer.view"
        },
        {
          "command": "mavenTestExplorer.showHistory",
          "group": "navigation@3",
          "when": "view == mavenTestExplorer.view"
        },
        {
          "command": "mavenTestExplorer.showListView",
          "group": "navigation@8",
          "when": "view == mavenTestExplorer.view && mavenTestExplorer.viewMode == tree"
        },
        {
          "command": "mavenTestExplorer.showTreeView",
          "group": "navigation@8",
          "when": "view == mavenTestExplorer.view && mavenTestExplorer.viewMode == list"
        }
      ],
      "testing/item/gutter": [
        {
          "command": "mavenTestExplorer.revealInCustomExplorer",
          "group": "navigation@1",
          "when": "controllerId == mavenTestExplorer"
        }
      ],
      "mavenTestExplorer.sortMenu": [
        {
          "command": "mavenTestExplorer.sortByLocation",
          "group": "sort@1",
          "when": "mavenTestExplorer.sortMode != location"
        },
        {
          "command": "mavenTestExplorer.sortByLocationAsc",
          "group": "sort@1",
          "when": "mavenTestExplorer.sortState == locationAsc"
        },
        {
          "command": "mavenTestExplorer.sortByLocationDesc",
          "group": "sort@1",
          "when": "mavenTestExplorer.sortState == locationDesc"
        },
        {
          "command": "mavenTestExplorer.sortByName",
          "group": "sort@4",
          "when": "mavenTestExplorer.sortMode != name"
        },
        {
          "command": "mavenTestExplorer.sortByNameAsc",
          "group": "sort@4",
          "when": "mavenTestExplorer.sortState == nameAsc"
        },
        {
          "command": "mavenTestExplorer.sortByNameDesc",
          "group": "sort@4",
          "when": "mavenTestExplorer.sortState == nameDesc"
        },
        {
          "command": "mavenTestExplorer.sortByStatus",
          "group": "sort@2",
          "when": "mavenTestExplorer.sortMode != status"
        },
        {
          "command": "mavenTestExplorer.sortByStatusAsc",
          "group": "sort@2",
          "when": "mavenTestExplorer.sortState == statusAsc"
        },
        {
          "command": "mavenTestExplorer.sortByStatusDesc",
          "group": "sort@2",
          "when": "mavenTestExplorer.sortState == statusDesc"
        },
        {
          "command": "mavenTestExplorer.sortByDuration",
          "group": "sort@3",
          "when": "mavenTestExplorer.sortMode != duration"
        },
        {
          "command": "mavenTestExplorer.sortByDurationAsc",
          "group": "sort@3",
          "when": "mavenTestExplorer.sortState == durationAsc"
        },
        {
          "command": "mavenTestExplorer.sortByDurationDesc",
          "group": "sort@3",
          "when": "mavenTestExplorer.sortState == durationDesc"
        }
      ],
      "mavenTestExplorer.clearMenu": [
        {
          "command": "mavenTestExplorer.clearResults",
          "group": "clear@1"
        },
        {
          "command": "mavenTestExplorer.clearResultsAndHistory",
          "group": "clear@2"
        }
      ],
      "commandPalette": [
        {
          "command": "mavenTestExplorer.expandAll",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.collapseAll",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByLocation",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByStatus",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByDuration",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByLocationAsc",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByLocationDesc",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByStatusAsc",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByStatusDesc",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByDurationAsc",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByDurationDesc",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByName",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByNameAsc",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.sortByNameDesc",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.showListView",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.showTreeView",
          "when": "false"
        },
        {
          "command": "mavenTestExplorer.revealInCustomExplorer",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "title": "Test Discovery",
        "order": 10,
        "properties": {
          "mavenTestExplorer.mavenExecutable": {
            "type": "string",
            "default": "mvn",
            "description": "Maven executable used when no Maven Wrapper is selected or found. Set an absolute path when 'mvn' is not available on PATH."
          },
          "mavenTestExplorer.preferMavenWrapper": {
            "type": "boolean",
            "default": true,
            "description": "Prefer the project's mvnw or mvnw.cmd so test runs use the Maven version expected by the project. Falls back to Maven Executable when no wrapper is found."
          },
          "mavenTestExplorer.testSourceGlobs": {
            "type": "array",
            "items": { "type": "string" },
            "default": ["**/src/test/java/**/*.java"],
            "description": "Java source patterns used for both test discovery and automatic file watching. Add a pattern when tests live outside src/test/java, for example '**/src/it/java/**/*.java'."
          },
          "mavenTestExplorer.autoRefreshOnSave": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "Refresh the explorer after matching Java test files are created, changed, or deleted, so the tree stays synchronized without a manual Refresh."
          },
          "mavenTestExplorer.autoRefreshDebounceMs": {
            "type": "number",
            "default": 500,
            "minimum": 100,
            "maximum": 5000,
            "order": 2,
            "description": "Wait this many milliseconds after the last Java test-file change before rediscovery. Increase it when rapid saves cause repeated expensive scans in large projects."
          }
        }
      },
      {
        "title": "Test Execution",
        "order": 20,
        "properties": {
          "mavenTestExplorer.defaultCommand": {
            "type": "string",
            "default": "clean test",
            "description": "Maven goals used by Run All Tests, for example 'clean test'. Class, method, and grouped runs use Test Class Command Template instead."
          },
          "mavenTestExplorer.defaultProfiles": {
            "type": "array",
            "items": { "type": "string" },
            "default": [],
            "description": "Profiles added to every test command. Use this when tests require project-specific environments such as dev or ci."
          },
          "mavenTestExplorer.additionalArgs": {
            "type": "string",
            "default": "",
            "description": "Extra arguments added to every Maven test command, for example environment properties or headless-browser flags."
          },
          "mavenTestExplorer.clearReportsBeforeRun": {
            "type": "boolean",
            "default": true,
            "description": "Delete existing TEST-*.xml files from the configured report locations before a run, preventing stale XML from appearing as results of the new run."
          },
          "mavenTestExplorer.testClassCommandTemplate": {
            "type": "string",
            "default": "{maven} {profiles} {args} -Dtest={className} test",
            "description": "Command template used for class, method, grouped, and failed-test runs. Change it when the project's test selector differs from Surefire -Dtest. Placeholders: {maven}, {profiles}, {args}, {className}."
          }
        }
      },
      {
        "title": "Results & Display",
        "order": 30,
        "properties": {
          "mavenTestExplorer.showOutputChannel": {
            "type": "boolean",
            "default": true,
            "description": "Open the Maven output panel when a run starts so command output and failures are immediately visible. Disable it to keep focus in the editor and open the output manually when needed."
          },
          "mavenTestExplorer.reportGlobs": {
            "type": "array",
            "items": { "type": "string" },
            "default": [
              "**/target/surefire-reports/TEST-*.xml",
              "**/target/failsafe-reports/TEST-*.xml"
            ],
            "description": "XML report patterns used for result loading, live watching, and pre-run cleanup. Add custom locations when the project writes reports outside the standard Surefire or Failsafe directories."
          },
          "mavenTestExplorer.watchReports": {
            "type": "boolean",
            "default": true,
            "description": "Watch the configured report files and update results after Maven runs started outside this extension. Changes take effect immediately; no window reload is required."
          },
          "mavenTestExplorer.rowLayout": {
            "type": "object",
            "additionalProperties": false,
            "default": {
              "tree": ["status", "kindIcon", "name", "metadata", "duration", "stats"],
              "list": ["status", "kindIcon", "name", "metadata", "duration", "stats"],
              "treeMetadata": ["description", "tags", "inheritance", "classContext", "virtualHint"],
              "listMetadata": ["description", "tags", "inheritance", "classContext", "virtualHint"]
            },
            "properties": {
              "tree": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["status", "kindIcon", "name", "metadata", "duration", "stats"]
                }
              },
              "list": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["status", "kindIcon", "name", "metadata", "duration", "stats"]
                }
              },
              "treeMetadata": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["description", "tags", "inheritance", "classContext", "virtualHint"]
                }
              },
              "listMetadata": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["description", "tags", "inheritance", "classContext", "virtualHint"]
                }
              }
            },
            "markdownDescription": "Reduce visual noise or preserve space by choosing which parts are rendered in test rows: [Configure Tree](command:mavenTestExplorer.configureTreeVisibleParts) | [Configure List](command:mavenTestExplorer.configureListVisibleParts). Expand Metadata to configure original Java names, tags, inherited sources, class context, and virtual-test hints separately. Expander is always visible because it is required for navigation. Display order is fixed; array order is ignored."
          }
        }
      },
      {
        "title": "Run History",
        "order": 40,
        "properties": {
          "mavenTestExplorer.runHistoryEnabled": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "Save newly completed runs so their results can be restored from the History button. Disabling this stops new entries but keeps existing history available."
          },
          "mavenTestExplorer.maxHistoryEntries": {
            "type": "number",
            "default": 20,
            "minimum": 1,
            "maximum": 100,
            "order": 2,
            "description": "Keep only this many newest run-history entries to limit workspace storage. Lowering the value removes older entries immediately."
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "npm run check-types && npm run validate:webview && node esbuild.js",
    "check-types": "tsc --noEmit",
    "validate:webview": "node scripts/validate-webview.js",
    "watch": "npm-run-all -p watch:esbuild watch:tsc",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run validate:webview && node esbuild.js --production",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.84.0",
    "esbuild": "^0.20.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "fast-xml-parser": "^4.3.0"
  }
}
